{
  "portal": {
    "build": {
      "builder": "DOCKERFILE",
      "dockerfilePath": "Dockerfile"
    },
    "deploy": {
      "preDeployCommand": [
        "python /app/bootstrap.py python -m app.operations migrate"
      ],
      "startCommand": "/bin/sh -c 'exec python /app/bootstrap.py uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --limit-concurrency 40 --timeout-keep-alive 5 --no-access-log --log-level warning'",
      "healthcheckPath": "/api/v1/health/ready",
      "healthcheckTimeout": 120,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5
    }
  },
  "Postgres": {
    "build": {
      "builder": "DOCKERFILE",
      "dockerfilePath": "deploy/railway-db/Dockerfile"
    },
    "deploy": {
      "preDeployCommand": [],
      "startCommand": null,
      "healthcheckPath": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5
    }
  },
  "mail": {
    "build": {
      "builder": "DOCKERFILE",
      "dockerfilePath": "Dockerfile"
    },
    "deploy": {
      "startCommand": "python /app/bootstrap.py python -m app.operations mail-loop",
      "healthcheckPath": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "preDeployCommand": [],
      "sleepApplication": false,
      "multiRegionConfig": {
        "ams": {
          "numReplicas": 1
        }
      }
    }
  }
}
