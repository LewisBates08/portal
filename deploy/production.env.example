# Supply these as encrypted App Platform RUN_TIME settings, not committed values.
ENVIRONMENT=production
FRONTEND_URL=https://portal.radiumsearch.com
TRUSTED_HOSTS=portal.radiumsearch.com
JWT_SECRET=GENERATE_RANDOM_64_HEX_CHARACTERS
ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
DATABASE_URL=postgresql+psycopg://searchroom_app:REPLACE@PRIVATE_DB_HOST:25060/searchroom?sslmode=verify-full&sslrootcert=/tmp/postgres-ca.crt
STATIC_DIR=/app/static
SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=Searchroom <accounts@your-domain.co.uk>
BACKUP_BUCKET=YOUR_PRIVATE_UK_BACKUP_BUCKET
BACKUP_REGION=eu-west-2
# Backup job only; never expose these to frontend or build steps.
BACKUP_KMS_KEY_ID=REPLACE
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE

# The public database CA in PEM format, as a multiline runtime value.
DATABASE_CA_CERT=REPLACE_WITH_DATABASE_CA_PEM
# App Platform proxy range; trust only the configured ingress, never arbitrary sources.
FORWARDED_ALLOW_IPS=REPLACE_WITH_TRUSTED_PROXY_RANGE
